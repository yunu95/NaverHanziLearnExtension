{
    "manifest_version": 3,
    "name": "네이버 한자사전을 통한 한자공부",
    "version": "1.11",
    "description": "네이버 한자사전을 통해 자원과 획순을 한 눈에 보면서 전략적인 주기로 한자를 공부하세요. 본 확장 프로그램은 고전에 쓰이는 한자 학습에 특히 탁월합니다.",
    "permissions": [
        "storage",
        "tabs"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["https://hanja.dict.naver.com/*"],
            "js": ["data/trad-to-simp.js", "content.js"]
        }
    ]
}
